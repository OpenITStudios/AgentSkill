{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenITStudios Portable Engineering Method Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "status",
    "canonicalOwner",
    "usage",
    "defaultEngineeringPass",
    "defaultPassMode",
    "commonConstraints",
    "methods"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "const": "oits-engineering-method-registry"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "SOURCE_REVIEWED_NOT_HOST_TESTED"
    },
    "canonicalOwner": {
      "const": ".agent-standard/core/engineering-and-review-methods.md"
    },
    "usage": {
      "type": "string",
      "minLength": 10
    },
    "defaultEngineeringPass": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "enum": [
          "karpathy-guidelines",
          "ponytail"
        ]
      }
    },
    "defaultPassMode": {
      "const": "single-compact-review"
    },
    "commonConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noAutoInstall",
        "noAutoAgentOrHostSwitch",
        "noCloudCiAsLocalTest",
        "requireCurrentUserPermission",
        "requireRealEvidenceForPass",
        "leaveDomainSkillOwnershipLocal"
      ],
      "properties": {
        "noAutoInstall": {
          "const": true
        },
        "noAutoAgentOrHostSwitch": {
          "const": true
        },
        "noCloudCiAsLocalTest": {
          "const": true
        },
        "requireCurrentUserPermission": {
          "const": true
        },
        "requireRealEvidenceForPass": {
          "const": true
        },
        "leaveDomainSkillOwnershipLocal": {
          "const": true
        }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "group",
          "state",
          "triggers",
          "negativeTriggers",
          "procedure",
          "sourceOnlyEvidence",
          "prohibitions",
          "caseIds",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 4
          },
          "group": {
            "enum": [
              "baseline",
              "conditional"
            ]
          },
          "state": {
            "const": "POLICY_ADAPTED_SOURCE_ONLY"
          },
          "triggers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "negativeTriggers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "procedure": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "sourceOnlyEvidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "prohibitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "caseIds": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "positive",
              "negative"
            ],
            "properties": {
              "positive": {
                "type": "string",
                "pattern": "^GOV-[0-9]{3}$"
              },
              "negative": {
                "type": "string",
                "pattern": "^GOV-[0-9]{3}$"
              }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "revision",
              "reviewedPath",
              "url",
              "copyPolicy"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 4
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "reviewedPath": {
                "type": "string",
                "minLength": 4
              },
              "url": {
                "type": "string",
                "pattern": "^https://github.com/"
              },
              "copyPolicy": {
                "const": "REFERENCE_PATTERN_ONLY_REVIEW_LICENSE_BEFORE_COPY"
              }
            }
          }
        }
      }
    }
  }
}
